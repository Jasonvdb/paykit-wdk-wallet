{
  "name": "paykit-wdk-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Example React Native wallet: Tether WDK for keys and money, Pubky Paykit for payable contacts. Testnet only.",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/patch-paykit.mjs && wdk-worklet-bundler generate",
    "demo-env": "node scripts/demo-env.mjs",
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild --clean",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "wdk-bundle": "wdk-worklet-bundler generate"
  },
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible-mono": "0.4.1",
    "@expo-google-fonts/atkinson-hyperlegible-next": "0.4.1",
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@noble/hashes": "1.8.0",
    "@noble/secp256k1": "2.2.3",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@synonymdev/react-native-paykit": "file:vendor/synonymdev-react-native-paykit.tgz",
    "@tetherto/wdk": "1.0.0-beta.19",
    "@tetherto/wdk-react-native-core": "1.0.0-beta.21",
    "@tetherto/wdk-wallet-btc": "1.0.0-beta.17",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.21",
    "bare-http1": "4.5.7",
    "bare-node-runtime": "1.5.0",
    "expo": "55.0.31",
    "expo-build-properties": "55.0.18",
    "expo-camera": "55.0.23",
    "expo-clipboard": "55.0.17",
    "expo-crypto": "55.0.19",
    "expo-dev-client": "55.0.40",
    "expo-font": "55.0.8",
    "expo-haptics": "55.0.18",
    "expo-image-manipulator": "55.0.21",
    "expo-image-picker": "55.0.24",
    "expo-linking": "55.0.17",
    "expo-status-bar": "55.0.6",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-bare-kit": "0.14.5",
    "react-native-keychain": "10.0.0",
    "react-native-mmkv": "4.3.2",
    "react-native-nitro-modules": "0.36.1",
    "react-native-qrcode-svg": "6.3.26",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@scure/base": "1.2.6",
    "@scure/bip39": "2.4.0",
    "@tetherto/wdk-worklet-bundler": "1.0.0-beta.15",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.2",
    "eslint": "9.39.4",
    "eslint-config-expo": "55.0.1",
    "ethers": "6.17.0",
    "jest": "29.7.0",
    "jest-expo": "55.0.22",
    "typescript": "5.9.2"
  },
  "overrides": {
    "bare-assert": "1.2.0",
    "bare-broadcast-channel": "0.2.0",
    "bare-buffer": "3.6.2",
    "bare-channel": "5.2.4",
    "bare-crypto": "1.15.3",
    "bare-dgram": "1.0.1",
    "bare-dns": "2.1.4",
    "bare-events": "2.9.1",
    "bare-fetch": "3.4.0",
    "bare-fs": "4.7.4",
    "bare-hrtime": "2.1.1",
    "bare-http-parser": "1.1.5",
    "bare-http1": "4.5.7",
    "bare-https": "3.0.0",
    "bare-inspect": "3.1.4",
    "bare-logger": "2.0.3",
    "bare-module-lexer": "1.6.3",
    "bare-module-resolve": "1.12.4",
    "bare-net": "2.3.2",
    "bare-path": "3.1.1",
    "bare-pipe": "4.2.2",
    "bare-sqlite": "0.1.4",
    "bare-stream": "2.13.3",
    "bare-structured-clone": "1.6.0",
    "bare-subprocess": "6.1.0",
    "bare-system-logger": "1.0.3",
    "bare-tcp": "2.5.2",
    "bare-thread": "1.2.4",
    "bare-timers": "3.2.1",
    "bare-tls": "3.1.7",
    "bare-tty": "5.1.2",
    "bare-type": "1.1.0",
    "bare-type-stripper": "0.1.4",
    "bare-url": "2.5.4",
    "bare-worker": "4.4.0",
    "bare-ws": "3.0.0",
    "@react-navigation/elements": "2.9.44"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts?(x)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/ios/",
      "<rootDir>/android/",
      "<rootDir>/.paykit-build/",
      "<rootDir>/vendor/"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|@noble))",
      "/node_modules/react-native-reanimated/plugin/"
    ]
  }
}
