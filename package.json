{
  "name": "paykit-wdk-wallet",
  "version": "0.1.0",
  "private": true,
  "description": "Example React Native wallet: Tether WDK for keys and money, Pubky Paykit for payable contacts. Testnet only.",
  "license": "MIT",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/patch-paykit.mjs && wdk-worklet-bundler generate",
    "demo-env": "node scripts/demo-env.mjs",
    "start": "expo start --dev-client",
    "prebuild": "expo prebuild --clean",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
