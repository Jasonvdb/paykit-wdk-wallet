{
  "expo": {
    "name": "Paykit WDK",
    "slug": "paykit-wdk-wallet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "paykitwdk",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF1F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jasonvdb.paykitwdkwallet",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jasonvdb.paykitwdkwallet",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "buildArchs": [
              "arm64-v8a"
            ]
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "./plugins/withPaykitSimulatorArchs",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a pay-me code to add a person.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile photo that your contacts will see.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "backgroundColor": "#EEF1F4"
  }
}
